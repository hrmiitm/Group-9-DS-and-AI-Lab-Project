# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — excludes files that must NOT be copied into the Docker image
# ─────────────────────────────────────────────────────────────────────────────

# Python cache & build artefacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl

# Virtual environments (we build a fresh one inside the image)
.venv/
venv/
env/
ENV/

# Test & coverage artefacts
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# Development & editor files
.git/
.gitignore
.gitattributes
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# Secrets and local environment files — NEVER bake these into the image
.env
.env.*
*.env
secrets/

# Documentation — not needed in the runtime image
*.md
docs/

# Model cache — will be downloaded at first run and cached in the container
.cache/

# CI / CD
.github/
.circleci/
Jenkinsfile
