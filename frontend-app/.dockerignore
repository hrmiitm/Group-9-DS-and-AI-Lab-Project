# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — excludes files from the Docker build context
# Keeps the build fast and prevents accidental inclusion of secrets/cache.
# ─────────────────────────────────────────────────────────────────────────────

# Node modules — installed fresh inside the container by `npm ci`
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Previous build output — the builder stage creates a fresh dist/
dist/
dist-ssr/

# Development & editor files
.git/
.gitignore
.gitattributes
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# Local environment / secrets — NEVER bake into the image
.env
.env.*
*.env
*.local

# Test & lint artefacts
coverage/
.nyc_output/
.eslintcache

# Documentation — not needed in the runtime image
*.md
